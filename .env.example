NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (chaves publicas usadas pelo app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only. Prefira a Secret key (sb_secret_...). Nunca exponha no navegador.
SUPABASE_SECRET_KEY=
# Compatibilidade legada, se o projeto ainda usar service_role JWT:
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago server-only
MERCADO_PAGO_ENV=test
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Usado apenas em teste quando o cliente importado nao possui e-mail.
MERCADO_PAGO_TEST_PAYER_EMAIL=

# WhatsApp / Evolution (proxima etapa)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
